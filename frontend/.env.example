# Variables for development
VITE_API_URL=http://localhost:8080
VITE_APP_TITLE=Sistema de Gestão de Entregas

# Cloudflare Turnstile — Site Key (pública). Criar em
# dashboard.cloudflare.com > Turnstile; a Secret Key correspondente vai no
# .env do backend (raiz do repo), nunca aqui.
VITE_TURNSTILE_SITE_KEY=