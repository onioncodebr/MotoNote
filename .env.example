# Variáveis de ambiente do backend. Copie para .env (ou exporte no shell /
# configure na run configuration da IDE) — o Spring Boot não carrega .env
# automaticamente, então essas variáveis precisam chegar ao processo por
# fora (export, docker-compose, run config).

# Obrigatório fora do profile "dev" — o boot falha sem ele (de propósito,
# pra não assinar tokens com um segredo previsível). Rodando com
# SPRING_PROFILES_ACTIVE=dev, application-dev.properties já define um valor
# de conveniência e essa variável pode ficar vazia.
JWT_SECRET=

# Stripe — modo teste primeiro (chaves sk_test_/whsec_ de teste).
# STRIPE_SECRET_KEY: Dashboard > Developers > API keys > Secret key.
# STRIPE_PRICE_ID: Dashboard > Product catalog > Price recorrente mensal criado.
# STRIPE_WEBHOOK_SECRET: em dev, o valor impresso por `stripe listen --forward-to localhost:8080/api/webhooks/stripe`.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=15

# URL do frontend, usada para montar success_url/cancel_url/return_url do
# Stripe Checkout e do Billing Portal.
FRONTEND_URL=http://localhost:5173
