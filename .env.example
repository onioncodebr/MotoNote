# Variáveis de ambiente do backend. Copie para .env (ou exporte no shell /
# configure na run configuration da IDE) — o Spring Boot não carrega .env
# automaticamente, então essas variáveis precisam chegar ao processo por
# fora (export, docker-compose, run config).

# Obrigatório fora do profile "dev" — o boot falha sem ele (de propósito,
# pra não assinar tokens com um segredo previsível). Rodando com
# SPRING_PROFILES_ACTIVE=dev, application-dev.properties já define um valor
# de conveniência e essa variável pode ficar vazia.
JWT_SECRET=

# Também obrigatório fora do profile "dev", mesmo motivo do JWT_SECRET acima
# (evita cair silenciosamente numa credencial fraca hardcoded). Em dev,
# application-dev.properties já aponta pro Mongo local do docker-compose.yml
# (admin/admin@localhost:27017) e essa variável pode ficar vazia.
SPRING_MONGODB_URI=

# Stripe — modo teste primeiro (chaves sk_test_/whsec_ de teste).
# STRIPE_SECRET_KEY: Dashboard > Developers > API keys > Secret key.
# STRIPE_PRICE_ID: Dashboard > Product catalog > Price recorrente mensal criado.
# STRIPE_WEBHOOK_SECRET: em dev, o valor impresso por `stripe listen --forward-to localhost:8080/api/webhooks/stripe`.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=15

# URL do frontend, usada para montar success_url/cancel_url/return_url do
# Stripe Checkout e do Billing Portal.
FRONTEND_URL=http://localhost:5173

# Resend — envio de e-mail (código de cadastro, recuperação de senha, troca
# de telefone). Sem essas variáveis, o backend sobe normalmente, mas esses
# fluxos respondem 503 (em dev, ficam sem efeito e o código só é logado —
# ver resend.log-fallback em application-dev.properties). Passo a passo
# completo em RESEND_SETUP.md.
# RESEND_API_KEY: Dashboard do Resend > API Keys > Create API Key.
# RESEND_FROM_EMAIL: precisa ser um endereço do domínio verificado no Resend.
# Aspas obrigatórias aqui: o valor tem "<" e ">", que o bash interpretaria
# como redirecionamento se você carregar este arquivo com `source .env`.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="MotoNote <naoresponda@seudominio.com>"

# Cloudflare Turnstile — verificação anti-automação em cadastro/login/
# recuperação de senha. Sem essa variável, o backend sobe normal e a
# verificação fica desligada (ver turnstile.secret-key em
# application.properties). Criar em dashboard.cloudflare.com > Turnstile —
# gera duas chaves: a Secret Key vai aqui, a Site Key (pública) vai em
# frontend/.env como VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Cloudflare R2 — armazenamento de foto de perfil (bucket público) e
# comprovante de gasto (bucket privado, servido só por link temporário).
# Sem essas variáveis, o backend sobe normal e os endpoints de upload
# respondem 503 até serem configuradas. Passo a passo completo em R2_SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=
R2_BUCKET_PRIVADO=
R2_PUBLIC_URL=
